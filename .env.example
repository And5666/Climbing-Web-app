# Copy to .env and fill in before first run. .env is gitignored.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# Required in production (the app refuses to start without it).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Production mode: no debug pages, secure cookies, hashed static files.
DJANGO_DEBUG=False
# Hosts the container answers to (comma-separated).
DJANGO_ALLOWED_HOSTS=summit.andw.net
# Origins allowed to POST (login, logging sends). Must be https URLs.
DJANGO_CSRF_ORIGINS=https://summit.andw.net
# Where the database and uploads live inside the container (a volume).
DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_MEDIA_PATH=/data/media
